# Copier ce fichier en « .env.local » pour le travail en local. Sur Vercel : Settings → Environment Variables (jamais dans le code).

# Adresse publique du site, sans « / » final. Sert aux adresses canoniques, au sitemap et à robots.txt.
NEXT_PUBLIC_SITE_URL=https://e-fanamby.mg

# Envoi des formulaires par e-mail (SMTP). Pour Gmail : mot de passe d'application (validation en 2 étapes requise), pas le mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=efanamby2025@gmail.com
SMTP_PASS=
# Facultatifs : destinataire (défaut : efanamby2025@gmail.com) et expéditeur (défaut : SMTP_USER)
MAIL_TO=
MAIL_FROM=

# Interrupteur de mise en ligne : laisser VIDE tant que le site n'est pas officiellement lancé (robots.txt reste fermé aux moteurs de recherche,
# même sur l'adresse *.vercel.app). Mettre 1 le jour J, dans Vercel → Settings → Environment Variables (environnement Production), puis redéployer.
ALLOW_INDEXING=

# --- Réservé aux tests et à la relecture, à NE PAS régler en production ---
# 1 = ouvre les langues en brouillon (anglais, malgache, espagnol) et ferme le site aux moteurs de recherche
NEXT_PUBLIC_PREVIEW=
# 1 = n'envoie aucun e-mail, écrit le message dans les journaux du serveur
MAIL_DRY_RUN=
